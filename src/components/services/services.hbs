<section class="services">
   <div class="container services__container">

      <div class="services__header">
         {{> section-header subtitle="range of" title="services" description="We’ll restore your furniture and give it a
         new lease on life" }}
      </div>

      <div class="services__grid">
         <article class="services__card">
            <a class="services__card-link" href="{{basePath '/pages/residential/index.html' }}">
               <div class="services__card-content">
                  <div class="services__image">
                     <picture>
                        <source media="(max-width: 767px)" srcset="/assets/images/services/residential-mobile.jpg" />
                        <source media="(min-width: 768px)" srcset="/assets/images/services/residential.jpg" />
                        <img src="/assets/images/services/residential.jpg" alt="Residential Furniture Service" />
                     </picture>
                  </div>
                  <div class="services__card-header">
                     <h3 class="services__title">Residential Furniture Service</h3>
                     <p class="services__text">We restore and professionally and carefully maintain leather furniture,
                        bringing it back to its original appearance and extending its lifespan.</p>
                  </div>
               </div>

            </a>
         </article>

         <article class="services__card">
            <a class="services__card-link" href="{{basePath '/pages/automotive/index.html' }}">
               <div class="services__card-content">
                  <div class="services__image">
                     <picture>
                        <source media="(max-width: 767px)" srcset="/assets/images/services/automotive-mobile.jpg" />
                        <source media="(min-width: 768px)" srcset="/assets/images/services/automotive.jpg" />
                        <img src="/assets/images/services/automotive.jpg" alt="Automotive Interior Restoration" />
                     </picture>
                  </div>
                  <div class="services__card-header">
                     <h3 class="services__title">Automotive Interior Restoration</h3>
                     <p class="services__text">We provide a full range of automotive interior services — from scratch
                        repairs
                        to complete upholstery restoration.</p>
                  </div>
               </div>
            </a>
         </article>

         <article class="services__card">
            <a class="services__card-link" href="{{basePath '/pages/commercial/index.html' }}">
               <div class="services__card-content">
                  <div class="services__image">
                     <picture>
                        <source media="(max-width: 767px)" srcset="/assets/images/services/commercial-mobile.jpg" />
                        <source media="(min-width: 768px)" srcset="/assets/images/services/commercial.jpg" />
                        <img src="/assets/images/services/commercial.jpg" alt="Commercial Furniture Repair" />
                     </picture>
                  </div>
                  <div class="services__card-header">
                     <h3 class="services__title">Commercial Furniture Repair</h3>
                     <p class="services__text">Professional repair and restoration of furniture for businesses and
                        public
                        spaces. <br />We restore the original look—no matter the wear and tear.</p>
                  </div>
               </div>
            </a>
         </article>

         <article class="services__card">
            <a class="services__card-link" href="{{basePath '/pages/cleaning/index.html' }}">
               <div class="services__card-content">
                  <div class="services__image">
                     <picture>
                        <source media="(max-width: 767px)" srcset="/assets/images/services/cleaning-mobile.jpg" />
                        <source media="(min-width: 768px)" srcset="/assets/images/services/cleaning.jpg" />
                        <img src="/assets/images/services/cleaning.jpg" alt="Leather Cleaning & Protecting" />
                     </picture>
                  </div>
                  <div class="services__card-header">
                     <h3 class="services__title">Leather Cleaning & Protecting</h3>
                     <p class="services__text">We offer spot treatment and full deep cleaning services. Providing
                        thorough
                        care, we restore cleanliness while preserving the protective properties of leather and vinyl.
                     </p>
                  </div>
               </div>
            </a>
         </article>
      </div>
   </div>
</section>