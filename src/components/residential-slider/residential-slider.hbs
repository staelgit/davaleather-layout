<section class="residential-slider">
   <div class="container residential-slider__container">

      <h2 class="residential-slider__title">We restore and professionally and carefully maintain leather furniture,
         bringing it back to its original
         appearance and extending its lifespan.</h2>

      <div class="residential-slider__gallery swiper">
         <div class="residential-slider__gallery-nav">
            {{> slider-nav prevClass="residential-slider__gallery-prev" nextClass="residential-slider__gallery-next" }}
         </div>
         <div class="residential-slider__gallery-wrapper swiper-wrapper">
            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/scuff-marks.jpg" alt="Remove scuff marks"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Remove scuff marks</h4>
            </div>

            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/scratches-tears.jpg" alt="Remove scratches and tears"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Remove scratches and tears</h4>
            </div>

            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/rips-cuts.jpg" alt="Stitch up rips and cuts"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Stitch up rips and cuts</h4>
            </div>

            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/burn-marks.jpg" alt="Repair burn marks"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Repair burn marks</h4>
            </div>

            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/bubbles-and-waves.jpg" alt="Eliminate bubbles and waves"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Eliminate bubbles and waves</h4>
            </div>

            <div class="residential-slider__gallery-slide swiper-slide">
               <div class="residential-slider__gallery-slide-image">
                  <img src="/assets/images/residential-slider/stains.jpg" alt="Clean stains"
                     class="residential-slider__gallery-img" />
               </div>
               <h4 class="residential-slider__gallery-slide-title">Clean stains</h4>
            </div>
         </div>
      </div>
   </div>
</section>