<section class="client-service">
   <div class="container client-service__container">
      <div class="client-service__content">
         <div class="client-service__header">
            {{> section-header subtitle="attention to" title="client service" description="When repair and restoration
            stop being a headache" }}
         </div>
      </div>
      <div class="client-service__features-gallery-wrapper">
         <div class="client-service__features">
            <div class="client-service__feature">
               <div class="client-service__feature-number">01</div>
               <h2 class="client-service__feature-title">on-site<br />service</h2>
               <p class="client-service__feature-text">We’ll assess the time and cost of the work online through photos
                  via WhatsApp or email—then come to you and fix everything on-site.</p>
            </div>
            <div class="client-service__feature-image">
               <img src="/assets/images/client-service/tools-in-the-car.jpg" alt="Tools in the car"
                  class="client-service__gallery-img" />
            </div>
            <div class="client-service__feature">
               <div class="client-service__feature-number">02</div>
               <h2 class="client-service__feature-title">we are<br />responsible<br />for the result</h2>
               <p class="client-service__feature-text">We stand behind our results.The restored leather will look
                  flawless — same color, same tone, no odd spots.</p>
            </div>
            <div class="client-service__feature client-service__feature--accent">
               <div class="client-service__feature-number">03</div>
               <h2 class="client-service__feature-title">quality guaranteed</h2>
               <p class="client-service__feature-text">All our restoration work comes<br />with a 6-month quality
                  guarantee. <br />If we reupholster anything, you also get the manufacturer’s warranty on the
                  materials.
               </p>
            </div>
            <div class="client-service__feature">
               <div class="client-service__feature-number">04</div>
               <h2 class="client-service__feature-title">fast, efficient & honest<br />work</h2>
               <p class="client-service__feature-text">Our team can get you in and out the same day. Fast, efficient
                  repairs while you wait. We work with both individuals and businesses. Digital payments? No problem.
                  <br />We handle all the paperwork properly, no stress.
               </p>
            </div>

            <div class="client-service__feature-image">
               <img src="/assets/images/client-service/hand-and-leather.jpg" alt="Leather restoration"
                  class="client-service__gallery-img" />
            </div>
         </div>

         <div class="client-service__gallery swiper">
            <div class="client-service__gallery-nav">

               {{> slider-nav prevClass="client-service__gallery-prev" nextClass="client-service__gallery-next" }}

            </div>
            <div class="client-service__gallery-wrapper swiper-wrapper">
               <div class="client-service__gallery-slide swiper-slide">
                  <div class="client-service__feature-number">01</div>
                  <h2 class="client-service__gallery-slide-title">on-site<br />service</h2>
                  <p class="client-service__gallery-slide-text">We’ll assess the time and cost of the work online
                     through photos
                     via WhatsApp or email—then come to you and fix everything on-site.</p>
               </div>
               <div class="client-service__gallery-slide-image swiper-slide">
                  <img src="/assets/images/client-service/tools-in-the-car.jpg" alt="Tools in the car"
                     class="client-service__gallery-img" />
               </div>
               <div class="client-service__gallery-slide swiper-slide">
                  <div class="client-service__feature-number">02</div>
                  <h2 class="client-service__gallery-slide-title">we are<br />responsible<br />for the result</h2>
                  <p class="client-service__gallery-slide-text">We stand behind our results.The restored leather will
                     look
                     flawless — same color, same tone, no odd spots.</p>
               </div>
               <div class="client-service__gallery-slide swiper-slide client-service__gallery-slide--accent">
                  <div class="client-service__feature-number">03</div>
                  <h2 class="client-service__gallery-slide-title">quality guaranteed</h2>
                  <p class="client-service__gallery-slide-text">All our restoration work comes<br />with a 6-month
                     quality
                     guarantee. <br />If we reupholster anything, you also get the manufacturer’s warranty on the
                     materials.
                  </p>
               </div>
               <div class="client-service__gallery-slide swiper-slide">
                  <div class="client-service__feature-number">04</div>
                  <h2 class="client-service__feature-title">fast, efficient & honest<br />work</h2>
                  <p class="client-service__gallery-slide-text">Our team can get you in and out the same day. Fast,
                     efficient
                     repairs while you wait. We work with both individuals and businesses. Digital payments? No problem.
                     <br />We
                     handle all the paperwork properly, no stress.
                  </p>
               </div>

               <div class="client-service__gallery-slide-image swiper-slide">
                  <img src="/assets/images/client-service/hand-and-leather.jpg" alt="Leather restoration"
                     class="client-service__gallery-img" />
               </div>
            </div>
         </div>
      </div>
   </div>
</section>