<section class="residential-price" data-component="residential-price">
   <div class="container residential-price__container">

      <div class="residential-price__tag">[price]</div>

      <div class="residential-price__tabs" data-residential-price-list>
         <article class="residential-price__item residential-price__item--active" data-residential-price-item>
            <button class="residential-price__trigger" type="button" aria-expanded="false"
               aria-controls="residential-price-panel-1" id="residential-price-trigger-1"
               data-residential-price-trigger>
               <span class="residential-price__trigger-label">By furniture type</span>
               <span class="residential-price__trigger-icon" aria-hidden="true"></span>
            </button>

            <div class="residential-price__panel" id="residential-price-panel-1" role="region"
               aria-labelledby="residential-price-trigger-1" hidden data-residential-price-panel>
               <ul class="residential-price__rows">
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Restoration of leather sofas and cushions</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Restoration of large interior items</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Restoration of leather armchairs and chairs</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Reupholstery and restoration of chairs</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Repair of desk and coffee table upholstery</span>
                     <span class="residential-price__row-price">from $100</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Repair of furniture after relocation</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
               </ul>

               <div class="residential-price__actions">
                  <button class="residential-price__action residential-price__action--primary" type="button"
                     data-modal-open="zipcode">Book now</button>
                  <button class="residential-price__action residential-price__action--ghost" type="button">Learn
                     more</button>
               </div>
            </div>
         </article>

         <article class="residential-price__item" data-residential-price-item>
            <button class="residential-price__trigger" type="button" aria-expanded="false"
               aria-controls="residential-price-panel-2" id="residential-price-trigger-2"
               data-residential-price-trigger>
               <span class="residential-price__trigger-label">By damage type</span>
               <span class="residential-price__trigger-icon" aria-hidden="true"></span>
            </button>

            <div class="residential-price__panel" id="residential-price-panel-2" role="region"
               aria-labelledby="residential-price-trigger-2" hidden data-residential-price-panel>
               <ul class="residential-price__rows">
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Remove scuffs</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Stain removal</span>
                     <span class="residential-price__row-price">from $100</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Remove scratches and tears</span>
                     <span class="residential-price__row-price">from $100</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Burn mark removal</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Tears and cuts repair</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Remove bubbles and waves</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Crack restoration</span>
                     <span class="residential-price__row-price">from $150</span>
                  </li>
               </ul>

               <div class="residential-price__actions">
                  <button class="residential-price__action residential-price__action--primary" type="button"
                     data-modal-open="zipcode">Book now</button>
                  <button class="residential-price__action residential-price__action--ghost" type="button">Learn
                     more</button>
               </div>
            </div>
         </article>

         <article class="residential-price__item" data-residential-price-item>
            <button class="residential-price__trigger" type="button" aria-expanded="false"
               aria-controls="residential-price-panel-3" id="residential-price-trigger-3"
               data-residential-price-trigger>
               <span class="residential-price__trigger-label">Technician visit</span>
               <span class="residential-price__trigger-icon" aria-hidden="true"></span>
            </button>

            <div class="residential-price__panel" id="residential-price-panel-3" role="region"
               aria-labelledby="residential-price-trigger-3" hidden data-residential-price-panel>
               <ul class="residential-price__rows">
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">With online estimate, you get a 3% discount on the total
                        amount</span>
                     <span class="residential-price__row-price">free</span>
                  </li>
                  <li class="residential-price__row">
                     <span class="residential-price__row-title">Without online estimate</span>
                     <span class="residential-price__row-price">$50</span>
                  </li>
               </ul>

               <div class="residential-price__actions">
                  <button class="residential-price__action residential-price__action--primary" type="button"
                     data-modal-open="zipcode">Book now</button>
                  <button class="residential-price__action residential-price__action--ghost" type="button">Learn
                     more</button>
               </div>
            </div>
         </article>
      </div>
   </div>
</section>