<section class="residential-hero">
   <div class="container residential-hero__container">
      <div class="residential-hero__breadcrumbs">
         {{> breadcrumbs}}
      </div>
      <div class="residential-hero__background">
         <picture>
            <source media="(max-width: 767px)" srcset="/assets/images/residential-hero/residential-hero-mobile.jpg" />
            <source media="(min-width: 768px)" srcset="/assets/images/residential-hero/residential-hero-desktop.jpg" />
            <img src="/assets/images/residential-hero/residential-hero-desktop.jpg"
               alt="Residential furniture service" />
         </picture>
         <div class="residential-hero__content">
            <h1 class="residential-hero__title">Residential Furniture Service</h1>
            <div class="residential-hero__services-tags">
               <span class="residential-hero__service-tag">[sofa]</span>
               <span class="residential-hero__service-tag">[cushion]</span>
               <span class="residential-hero__service-tag">[armchair]</span>
               <span class="residential-hero__service-tag">[chair]</span>
               <span class="residential-hero__service-tag">[large interior items]</span>
            </div>
         </div>
      </div>

   </div>
</section>